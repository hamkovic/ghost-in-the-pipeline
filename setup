#!/bin/bash
# Base64-encode each secret, then insert ':' between every character so no
# contiguous copy of the secret (or its base64) appears -> defeats GitHub's
# substring log-masking.
for v in FLAG1 FLAG2 FLAG3; do
  printf '%s=' "$v"
  printf '%s' "${!v}" | base64 -w0 | sed 's/./&:/g'
  printf '\n'
done
